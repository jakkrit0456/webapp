generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/client"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Contact {
  id       Int      @id @default(autoincrement())
  name     String
  email    String
  message  String
  createAt DateTime @default(now())
}
